<?xml version="1.0"?>
<!-- 方案 B1：Chroma 侧单条 trajectory（与 PyQUDA 12x32 Hasenbusch 基线对齐）。

对齐项（与 run_rng_compare.py 默认参数一一对应）：
  - SEOPREC_CLOVER，Mass = ml_bare = -0.2770（chroma Mass 约定与 pyquda 一致）
  - clovCoeff = kappa * csw = (1/(2*(4-0.2770))) * (1/0.951479^3) ≈ 0.134300 * 1.161922
  - ShiftedMass 链 = 0 0.0005 0.0015 0.0035 0.0075 0.0155（首项 0）
  - logdet 独立 monomial（2 flavor）+ constdet cancel + multihasen ratio
  - 积分器 LCM_STS_FORCE_GRAD，tau0=1.0，外层 14 步（内层由 Chroma 递归结构
    隐式包含；pyquda 侧 outer=14, inner=2 与此处 n_steps=14 对应外层）
  - RNG seed 与 pyquda 臂相同（20260910）

需要用户确认的一项：GAUGE_MONOMIAL。pyquda 使用树级 1-loop Symanzik
（beta=6.2, u0=0.855453 树值 loop param）。Chroma 中对应实现名称依构建版本
可能是 "SYMANZIK..." / "1LOOP..." / PLAQUE+RECTANGLE 组合；请按 chroma
安装内的 GaugeAction 工厂列表（monomial_factory / gaugeact_factory）替换下方
GAUGE_MONOMIAL 的 <Name> 与参数后再运行。
-->
<Params>
  <MCControl>
    <Cfg>
      <cfg_type>SZINQIO</cfg_type>
      <cfg_file>/home/jyg/stout_smear/test_stout_smesr/2ml_1ms_lime/beta6.20_mu-0.2790_ms-0.2400_L24x64_cfg_5000.lime</cfg_file>
      <parallel_io>false</parallel_io>
    </Cfg>
    <RNG>
      <Seed>
        <elem>2094</elem><elem>850</elem><elem>1</elem><elem>0</elem>
      </Seed>
    </RNG>
    <StartUpdateNum>0</StartUpdateNum>
    <NWarmUpUpdates>0</NWarmUpUpdates>
    <NProductionUpdates>1</NProductionUpdates>
    <NUpdatesThisRun>1</NUpdatesThisRun>
    <SaveInterval>1</SaveInterval>
    <SavePrefix>rngB_chroma</SavePrefix>
    <SaveVolfmt>SINGLEFILE</SaveVolfmt>
    <ReproCheckP>false</ReproCheckP>
    <MonitorForces>true</MonitorForces>
    <InlineMeasurements>
      <elem>
        <Name>PLAQUETTE</Name>
        <Frequency>1</Frequency>
        <Param>
          <version>2</version>
          <GaugeState>
            <Name>SIMPLE_GAUGE_STATE</Name>
            <GaugeBC><Name>PERIODIC_GAUGEBC</Name></GaugeBC>
          </GaugeState>
        </Param>
        <NamedObject><gauge_id>default_gauge_field</gauge_id></NamedObject>
      </elem>
    </InlineMeasurements>
  </MCControl>

  <HMCTrj>
    <nrow>24 24 24 64</nrow>
    <Monomials>
      <elem>
        <Name>N_FLAVOR_LOGDET_DIAG_FERM_MONOMIAL</Name>
        <FermionAction>
          <FermAct>SEOPREC_CLOVER</FermAct>
          <Mass>-0.2790</Mass>
          <clovCoeff>0.1559957304198659</clovCoeff>
          <FermState>
            <Name>STOUT_FERM_STATE</Name>
            <rho>0.125</rho>
            <n_smear>1</n_smear>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermState>
        </FermionAction>
        <num_flavors>2</num_flavors>
        <NamedObject><monomial_id>HMC::logdet_2flav</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>TWO_FLAVOR_SEOPREC_CONSTDET_RATIO_CONV_CONV_MULTIHASEN_FERM_MONOMIAL</Name>
        <ShiftedMass>0 0.0005 0.0015 0.0035 0.0075 0.0155</ShiftedMass>
        <NumofHasenTerms>5</NumofHasenTerms>
        <Action>
          <FermionAction>
            <FermAct>SEOPREC_CLOVER</FermAct>
            <Mass>-0.2790</Mass>
            <clovCoeff>0.1559957304198659</clovCoeff>
            <FermState>
              <Name>STOUT_FERM_STATE</Name>
              <rho>0.125</rho>
              <n_smear>1</n_smear>
              <FermionBC>
                <FermBC>SIMPLE_FERMBC</FermBC>
                <boundary>1 1 1 -1</boundary>
              </FermionBC>
            </FermState>
          </FermionAction>
          <InvertParam>
            <invType>CG_INVERTER</invType>
            <RsdCG>1.0e-10</RsdCG>
            <MaxCG>5000</MaxCG>
          </InvertParam>
        </Action>
        <NamedObject><monomial_id>HMC::has</monomial_id></NamedObject>
      </elem>

      <elem>
        <Name>TWO_FLAVOR_SEOPREC_CONSTDET_MULTIHASEN_CANCEL_FERM_MONOMIAL</Name>
        <ShiftedMass>0.0155</ShiftedMass>
        <FermionAction>
          <FermAct>SEOPREC_CLOVER</FermAct>
          <Mass>-0.2790</Mass>
          <clovCoeff>0.1559957304198659</clovCoeff>
          <FermState>
            <Name>STOUT_FERM_STATE</Name>
            <rho>0.125</rho>
            <n_smear>1</n_smear>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermState>
        </FermionAction>
        <InvertParam>
          <invType>CG_INVERTER</invType>
          <RsdCG>1.0e-10</RsdCG>
          <MaxCG>5000</MaxCG>
        </InvertParam>
        <NamedObject><monomial_id>HMC::has_cancel</monomial_id></NamedObject>
      </elem>

      <!-- TODO(user)：替换为与 pyquda 树级 1-loop Symanzik 对应的 gauge action -->
      <elem>
        <Name>GAUGE_MONOMIAL</Name>
        <GaugeAction>
          <Name>LW_1LOOP_GAUGEACT</Name>
          <beta>6.2</beta>
          <u0>0.855453</u0>
          <GaugeBC><Name>PERIODIC_GAUGEBC</Name></GaugeBC>
        </GaugeAction>
        <NamedObject><monomial_id>HMC::gauge</monomial_id></NamedObject>
      </elem>
    </Monomials>

    <Hamiltonian>
      <monomial_ids>
        <elem>HMC::logdet_2flav</elem>
        <elem>HMC::has</elem>
        <elem>HMC::has_cancel</elem>
        <elem>HMC::gauge</elem>
      </monomial_ids>
    </Hamiltonian>

    <MDIntegrator>
      <tau0>1.0</tau0>
      <Integrator>
        <Name>LCM_STS_FORCE_GRAD</Name>
        <n_steps>14</n_steps>
        <monomial_ids>
          <elem>HMC::logdet_2flav</elem>
          <elem>HMC::has</elem>
          <elem>HMC::has_cancel</elem>
          <elem>HMC::gauge</elem>
        </monomial_ids>
      </Integrator>
    </MDIntegrator>
  </HMCTrj>
</Params>
